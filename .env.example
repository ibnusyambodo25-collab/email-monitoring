# Koneksi PostgreSQL. Format: postgres://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
DATABASE_URL=postgres://postgres:GANTI_PASSWORD@localhost:5432/rejected_mail

# Kunci enkripsi password POP3 (AES-256-GCM): 32 byte dalam base64.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# JANGAN diganti setelah password POP3 tersimpan, karena password lama tidak bisa dibuka lagi.
APP_ENCRYPTION_KEY=

# Port server API lokal (server hanya listen di 127.0.0.1)
APP_PORT=3000
